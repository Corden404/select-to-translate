{
  "manifest_version": 3,
  "name": "右键查词工具",
  "version": "0.4.0",
  "description": "选中英文单词或句子后，结合上下文调用大模型进行快速解释。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "右键查词工具",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-auto-lookup": {
      "suggested_key": {"default": "Alt+Shift+L"},
      "description": "开启或关闭自动查词"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
