{
  "manifest_version": 3,
  "name": "Selection Lookup",
  "version": "0.1.0",
  "description": "Fast context-aware English lookup for selected text.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle automatic lookup"
  },
  "commands": {
    "toggle-auto-lookup": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle automatic lookup"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
